import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { IconButton } from "../primitives/panel.slint";
import { ThinScrollbar } from "../primitives/scrollbar.slint";
import { TrackData, TrackSize } from "model.slint";

// The lane switches, in a fixed column beside the lanes.
//
// No label on a row: the lanes are untyped, so there is no kind to name, and
// a lane's place in the stack is the only handle anything needs on it.
//
// Both a visibility and a mute toggle on every row, because a track is not
// typed — the same lane can be carrying a video clip and an mp3 side by side,
// and each needs its own switch.
//
// The column scrolls with the lanes rather than on its own: the offset is the
// caller's `track-scroll`, so the labels and the lanes cannot drift apart.
// There is one source of truth for how far down the stack we are.
//
// The bar that drives it lives here, at the edge of this column: the one
// place a stack of lanes can carry a scrollbar without landing on top of a
// clip.
//
// ponytail: the row-height menu is gone — four sizes were one more decision
// than a phone's editor earns, and the lane heights are the defaults now.
// Remove is a long-press overlay, not a fourth row: held 550ms, a scrim
// lifts over the three switches and the cross floats on it.

component Header inherits Rectangle {
    in property <TrackData> track;
    in property <bool> removable;

    callback flag-changed(visible: bool, muted: bool, locked: bool);
    callback removed();

    // ponytail: the long-press state sits on the component root so the
    // timer, the scrim and the cross can all reach it — Slint will not let
    // one element write another's properties.
    property <bool> remove-armed;
    property <bool> hold-live;
    hold-timer := Timer {
        interval: 550ms;
        running: row.pressed && root.hold-live && !root.remove-armed;
        triggered => {
            root.hold-live = false;
            root.remove-armed = true;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line;
    }

    row := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.press-x = self.absolute-position.x + self.mouse-x;
                self.press-y = self.absolute-position.y + self.mouse-y;
                root.hold-live = root.removable;
            } else if (event.kind == PointerEventKind.up
                || event.kind == PointerEventKind.cancel) {
                root.hold-live = false;
                root.remove-armed = false;
            }
        }
        moved => {
            // A press that strays past 8px is a scroll of the stack, not a
            // hold: the arm drops, the same slop the clips' long-press uses.
            if (root.hold-live
                && ((self.absolute-position.x + self.mouse-x - self.press-x).abs() > 8px
                    || (self.absolute-position.y + self.mouse-y - self.press-y).abs() > 8px)) {
                root.hold-live = false;
            }
        }
        property <length> press-x;
        property <length> press-y;

        VerticalLayout {
            padding-left: 5px;
            padding-right: 4px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 0px;
            // ponytail: three switches, one per row, tighter than the tray —
            // 2px between chips. The long-press scrim covers all three and
            // the cross floats over it, so remove costs no row of its own.

            VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: root.track.locked ? Glyph.lock : Glyph.unlock;
                    label: root.track.locked ? I18n.t("Unlock lane") : I18n.t("Lock lane");
                    icon-size: 12px;
                    checked: root.track.locked;
                    clicked => {
                        if (!root.remove-armed) {
                            root.flag-changed(root.track.visible, root.track.muted,
                                !root.track.locked);
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    // Checked when the lane is *off*: the button is lit to say
                    // something is being withheld, which is the state worth
                    // announcing.
                    glyph: root.track.visible ? Glyph.eye : Glyph.eye-off;
                    label: root.track.visible ? I18n.t("Hide lane") : I18n.t("Show lane");
                    icon-size: 12px;
                    checked: !root.track.visible;
                    clicked => {
                        if (!root.remove-armed) {
                            root.flag-changed(!root.track.visible, root.track.muted,
                                root.track.locked);
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: root.track.muted ? Glyph.volume-off : Glyph.volume;
                    label: root.track.muted ? I18n.t("Unmute lane") : I18n.t("Mute lane");
                    icon-size: 12px;
                    checked: root.track.muted;
                    clicked => {
                        if (!root.remove-armed) {
                            root.flag-changed(root.track.visible, !root.track.muted,
                                root.track.locked);
                        }
                    }
                }
            }
        }

        // The long-press scrim and the cross, over the switches. The press
        // that armed it is still held, so this TouchArea takes the release
        // that confirms the removal.
        if root.remove-armed: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: Theme.scrim.with-alpha(0.55);
            border-radius: Theme.r-sm;

            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel) {
                        root.hold-live = false;
                        root.remove-armed = false;
                    }
                }
                clicked => { root.removed(); }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: Glyph.trash;
                    label: I18n.t("Remove lane");
                    icon-size: 16px;
                    danger: true;
                    clicked => { root.removed(); }
                }
            }
        }
    }
}

export component TrackHeaders inherits Rectangle {
    /// Top lane first, so index 0 is the row drawn at the top of the lanes.
    /// Each row carries its own height and where it starts; see TrackData.
    in property <[TrackData]> tracks;
    in property <length> ruler-height: 28px;
    in property <length> track-scroll;
    /// How much taller the stack is than the room it has. Handed down rather
    /// than measured here: the pane already works it out to clamp the offset,
    /// and two answers to one question is one answer too many.
    in property <length> overflow;

    /// The bar was dragged, or the column wheeled. Absolute, and already
    /// inside 0..overflow.
    callback scrolled(offset: length);

    callback flag-changed(index: int, visible: bool, muted: bool, locked: bool);
    callback removed(index: int);

    clip: true;

    // A wheel over a lane's name scrolls the stack, the same stack a wheel
    // over its lane scrolls: the column is the left end of the same rows,
    // and a wheel that works over one end of a row and not the other reads
    // as broken. Ancestor of the rows, the bar and the corner, so a wheel
    // none of them handles bubbles up to it; a sibling would not see it.
    wheel := TouchArea {
        scroll-event(event) => {
            if (event.delta-y == 0px) {
                return EventResult.reject;
            }
            // Negated because Slint's delta-y is positive scrolling *up*,
            // and up is a smaller offset. Clamped here the way the pane
            // clamps the lanes' wheel, so the two never disagree.
            root.scrolled(Math.max(0px, Math.min(root.overflow,
                root.track-scroll - event.delta-y)));
            return EventResult.accept;
        }

        for track[index] in root.tracks: Header {
            x: 0;
            y: root.ruler-height + track.top - root.track-scroll;
            width: parent.width;
            height: track.height;
            // Clipped to the stack rather than allowed to ride over the ruler,
            // which a scrolled row would otherwise do.
            visible: self.y + track.height > root.ruler-height && self.y < root.height;

            track: track;
            removable: root.tracks.length > 1;

            flag-changed(visible, muted, locked) => {
                root.flag-changed(index, visible, muted, locked);
            }
            removed => { root.removed(index); }
        }

        // The bar, over the rows and under the corner. On the trailing edge,
        // where the stack it scrolls ends and where a scroll container puts one.
        // Short and inset rather than full-height: a stack that overflows by a
        // row would otherwise draw a thumb the length of the column, and a mark
        // that long stops reading as something you can take hold of.
        ThinScrollbar {
            x: parent.width - self.width - 1px;
            y: root.ruler-height + 4px;
            height: Math.max(0px, root.height - root.ruler-height - 8px);
            viewport: self.height;
            content: self.height + root.overflow;
            offset: root.track-scroll;
            min-thumb: 16px;
            max-thumb: 0.5;
            scrolled(to) => { root.scrolled(to); }
        }

        // The ruler corner: opposite the ruler, and not part of the scrolling
        // stack. Declared after the rows so it paints over whichever one is
        // half-scrolled behind it — `visible` above drops a row only once it is
        // fully past, and this covers the sliver in between.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.ruler-height;
            background: Theme.ruler;

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }
        }
    }
}
